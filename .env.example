PORT=3000

# Banco SQLite gerado a partir das planilhas
DB_PATH=./DadosTabelas.db

# Tabela 8 (principal para comparacao por interpretacao)
TABLE8_NAME=elemento_item_despesa
TABLE8_ID_COLUMN=cd_elemento_item
TABLE8_NAME_COLUMN=denominacao_item_despesa
TABLE8_INTERPRETATION_COLUMN=interpretacao

# Azure (gpt-4.1-mini)
AZURE_ENDPOINT=https://SEU-RECURSO.azure.com
AZURE_API_KEY=COLE_SUA_CHAVE
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure OCR (Mistral Document AI)
# Usa a mesma chave AZURE_API_KEY
AZURE_OCR_AUTH_MODE=api-key
# Opcional: se nao informar, usa AZURE_ENDPOINT
# AZURE_OCR_BASE_URL=https://SEU-ENDPOINT-AZURE-PARA-OCR
AZURE_OCR_MODEL=mistral-document-ai-2512

# Quantidade de retornos por item extraido
TOP_K_MATCHES=5
